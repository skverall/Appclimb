{
  "name": "appclimb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare:web:staging": "opennextjs-cloudflare build --env staging && opennextjs-cloudflare deploy --env staging",
    "deploy:cloudflare:web": "opennextjs-cloudflare build --env='' && opennextjs-cloudflare deploy --env=''",
    "deploy:cloudflare:api:staging": "wrangler deploy --config cloudflare/api/wrangler.jsonc --env staging",
    "deploy:cloudflare:api": "wrangler deploy --config cloudflare/api/wrangler.jsonc --env=''",
    "cloudflare:types": "wrangler types --config cloudflare/api/wrangler.jsonc --env staging cloudflare/api/worker-configuration.d.ts",
    "cloudflare:d1:local": "wrangler d1 migrations apply appclimb-staging --local --config cloudflare/api/wrangler.jsonc --env staging",
    "cloudflare:d1:staging": "wrangler d1 migrations apply appclimb-staging --remote --config cloudflare/api/wrangler.jsonc --env staging",
    "cloudflare:d1:production": "wrangler d1 migrations apply appclimb-production --remote --config cloudflare/api/wrangler.jsonc --env=''",
    "cloudflare:import:vps:staging": "bash cloudflare/api/scripts/import-vps-snapshot.sh staging",
    "cloudflare:import:vps:production": "bash cloudflare/api/scripts/import-vps-snapshot.sh production",
    "cloudflare:api:test": "vitest run cloudflare/api",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-/Volumes/LexarDev/Developer/Caches/ms-playwright} playwright test",
    "test:e2e:account": "APPCLIMB_E2E_ACCOUNT_LIFECYCLE=1 PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-/Volumes/LexarDev/Developer/Caches/ms-playwright} playwright test tests/e2e/account-lifecycle.isolated.spec.ts",
    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run build:cloudflare && npm run cloudflare:api:test && npm run worker:test && npm run worker:vet",
    "worker:test": "cd worker && go test ./...",
    "worker:vet": "cd worker && go vet ./...",
    "worker:run": "cd worker && go run ./cmd/appclimb-worker"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@paddle/paddle-js": "^1.6.4",
    "clsx": "^2.1.1",
    "d3-shape": "^3.2.0",
    "hono": "^4.12.32",
    "lucide-react": "^1.26.0",
    "motion": "^12.42.2",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^29.1.1",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
