{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "appclimb-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "appclimb-db",
      "database_id": "2b7a1018-9156-4a25-acce-22b6bdd51e71",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "env": {
    "staging": {
      "name": "appclimb-web-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "appclimb-db-staging",
          "database_id": "f9fe269f-ac56-4dd7-aba2-62bb5bedb5dc",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
